# Docker 镜像 tag（build.sh）
IMAGE_TAG=latest

# 硅基流动（OpenAI 兼容）— Deep Agent LLM
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
LLM_TEMPERATURE=0.2

# MCP via Higress SSE（宿主机 Agent）
MCP_SSE_URL=http://localhost:8081/mcp/mcp-test/sse
MCP_SERVER_NAME=mcp-test

# Agent 容器内使用 Higress 容器名：
# MCP_SSE_URL=http://higress:8080/mcp/mcp-test/sse

# 前端连接 LangGraph API
VITE_AGENT_URL=http://localhost:2024

# 可选 LangSmith 追踪
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
